
{
  "name": "gridiron-legacy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx watch backend/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "vite build",
    "build:backend": "tsc backend/server.ts --outDir dist/backend --module es2020 --target es2020 --moduleResolution node",
    "preview": "vite preview",
    "server": "node dist/backend/server.js",
    "start": "npm run build && npm run build:backend && npm run server",
    "backend": "tsx backend/server.ts"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "lucide-react": "^0.562.0",
    "recharts": "^3.6.0",
    "@google/genai": "^1.35.0",
    "express": "^5.2.1",
    "cors": "^2.8.5",
    "axios": "^1.18.0",
    "dotenv": "^16.4.0",
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "vite": "^8.2.2",
    "typescript": "^5.7.0",
    "tsx": "^4.7.0",
    "concurrently": "^8.2.2",
    "@types/better-sqlite3": "^7.6.8"
  }
}
