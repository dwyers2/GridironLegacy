# Gemini AI API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Yahoo Fantasy Sports API Credentials
# Get these from: https://developer.yahoo.com/apps/
# Create a new app and use "Installed Application" type for PKCE flow
YAHOO_CLIENT_ID=your_yahoo_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_client_secret_here

# OAuth Redirect URI
# This must match EXACTLY what's configured in your Yahoo Developer Console
# For local development with ngrok, use your ngrok URL
# Example: https://your-subdomain.ngrok-free.app
# For production, use your actual domain
REDIRECT_URI=https://your-ngrok-or-production-url.com

# Backend Server Port
PORT=3001

# Node Environment
NODE_ENV=development
